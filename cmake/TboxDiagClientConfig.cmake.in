@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# TBoxFramework: tbox_diag_client 静态链接 framework-ipc（PRIVATE）。
# 静态库的 PRIVATE 依赖在导出集中以 $<LINK_ONLY:...> 形式保留，最终链接时
# 需由消费方解析，故必须声明 find_dependency，否则消费方 configure 阶段报
# "target TBoxFramework::ipc not found"。
find_dependency(TboxFramework CONFIG)

# nlohmann_json: tbox_diag_client 的 PUBLIC 链接依赖（DTO 序列化）。
find_dependency(nlohmann_json CONFIG)

include("${CMAKE_CURRENT_LIST_DIR}/TboxDiagClientTargets.cmake")

check_required_components(TboxDiagClient)
